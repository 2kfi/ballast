*.test
*.out
coverage.html

# local env + compose overrides (secrets live here, not in git)
.env
docker-compose.override.yml

# scratch dirs for local serve/gc experiments
tmp/
scratch/

# editor / OS noise
.DS_Store
.idea/
.vscode/
